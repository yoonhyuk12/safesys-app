{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/worklog.js\"",
            "timeout": 10,
            "statusMessage": "작업 로그 기록 중"
          }
        ],
        "description": "이번 턴의 작업 수정사항을 log.md 맨 위에 'YYMMDD_HHMMSS : 내용' 형식으로 기록"
      }
    ]
  }
}
