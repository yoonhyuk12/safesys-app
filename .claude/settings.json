{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell|mcp__hwpx__.*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/log_change.py\"",
            "timeout": 30,
            "statusMessage": "log.md 기록 중"
          }
        ],
        "description": "git status 스냅샷을 비교해 실제로 바뀐 파일을 log.md 맨 위에 기록"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session_brief.py\"",
            "timeout": 15
          }
        ],
        "description": "log.md 최근 항목을 세션 시작 컨텍스트로 주입"
      }
    ]
  }
}
